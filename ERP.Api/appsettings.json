{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "__SET_IN_USER_SECRETS_OR_ENV__"
  },
  "JwtSettings": {
    "Secret": "__SET_IN_USER_SECRETS_OR_ENV__",
    "Issuer": "ErpKhoApi",
    "Audience": "ErpKhoClient",
    "ExpiryMinutes": 15
  },
  "SessionSecurity": {
    "RefreshTokenDays": 14,
    "RetentionDays": 30,
    "SameSite": "Strict"
  },
  "StockTransfer": {
    "RequireDifferentApprover": false
  },
  "StockReservation": {
    "DefaultExpiryMinutes": 120
  },
  "ExportWorkflow": {
    "WriteEnabled": true
  },
  "ExportReceipt": {
    "AllowPerReceiptDispatchMode": true,
    "DefaultDispatchMode": "RequireSeparateDispatch",
    "AllowWarehouseStaffDirectDispatch": false,
    "RequireDifferentDispatcher": false
  },
  "AuthSecurity": {
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15
  },
  "RateLimiting": {
    "Login": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    },
    "Api": {
      "PermitLimit": 120,
      "WindowSeconds": 60
    }
  },
  "AllowedHosts": "*"
}
